{
  "expo": {
    "name": "Lifeline Hospital",
    "slug": "lifeline-hospital",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F8F7"
    },
    "android": {
      "package": "com.yourcompany.lifeline",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F8F6"
      }
    },
    "ios": {
      "bundleIdentifier": "com.yourcompany.lifeline"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to attach your photo."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
        "baseUrl": "/lifeline-hospital-"
      }
  }
}